{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Insight Data Uploads Utility",
  "version": "0.1.0",
  "identifier": "com.insight.datauploads.utility",
  "build": {
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/insight-data-upload-ui/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Data Uploads Utility",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; connect-src 'self' http: https:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../src/assets/config/app-config.json": "config/app-config.json"
    }
  }
}
