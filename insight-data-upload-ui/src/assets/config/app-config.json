{
  "springBoot": {
    "baseUrl": "http://localhost:8081",
    "paths": {
      "health": "/actuator/health",
      "submitPacket": "/api/v1/packets",
      "submitCase": "/api/v1/cases",
      "initiateUpload": "/api/v1/uploads/initiate",
      "presignPart": "/api/v1/uploads/{uploadId}/parts/{partNumber}/presign",
      "listParts": "/api/v1/uploads/{uploadId}/parts",
      "completeUpload": "/api/v1/uploads/{uploadId}/complete"
    }
  },
  "application": {
    "governmentWebsiteUrl": "https://www.incometaxindia.gov.in/",
    "name": "Insight Data Uploads Utility",
    "environment": "desktop",
    "defaultCaseDesignation": "Data Upload Utility"
  },
  "features": {},
  "virtualScroll": {
    "rowHeightPx": 40,
    "bufferRows": 20,
    "renderedRows": 50
  },
  "pagination": {
    "defaultPageSize": 50,
    "pageSizeOptions": [
      10,
      25,
      50,
      100
    ]
  },
  "tooling": {
    "devServerHost": "localhost",
    "devServerPort": 4200,
    "devUrlHost": "http://localhost"
  },
  "csvImport": {
    "batchRows": 10000,
    "readyRows": 100,
    "progressRows": 10000,
    "sqliteCacheMb": 64,
    "maxFileBytes": 1073741824
  }
}
