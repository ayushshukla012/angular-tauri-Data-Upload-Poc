# Force LF regardless of what a contributor's local core.autocrlf is set to.
# Without this, cloning on Windows can silently convert .sh files to CRLF,
# which breaks Bash with a "$'\r': command not found" error inside WSL/Git Bash
# too — this isn't a "Windows problem," it's a "whoever's git config is wrong"
# problem, so it's enforced here rather than left to individual configuration.
* text=auto eol=lf

*.sh text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.proto text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows-only file, needs CRLF regardless of the rule above.
*.bat text eol=crlf

# Binary — never touch line endings.
*.jar binary
*.png binary
*.jpg binary
*.ico binary
